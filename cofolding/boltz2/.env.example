# Copy to .env; replace every placeholder. No shell sourcing is required.
BOLTZ_IMAGE=container-library/boltz2:2.2.1
BOLTZ_UID=1000
BOLTZ_GID=1000
BOLTZ_GPU=GPU-REPLACE-WITH-ALLOCATED-UUID
BOLTZ_INPUTS=/absolute/path/to/inputs
BOLTZ_OUTPUTS=/absolute/path/to/outputs
BOLTZ_CACHE_HOST=/absolute/path/to/cache
BOLTZ_CPUS=8
BOLTZ_MEMORY=36g
BOLTZ_SHM_SIZE=8gb
